# Copy to .env.local (git-ignored). Use credentials scoped to the intended test workspace.
# Load explicitly: uv run --locked --env-file .env.local python tools/audit_payloads.py
# The extension does not read this file or the SCENARIO_TEST_* variables.
# Offline tests need no credentials. Never commit .env.local.
SCENARIO_TEST_API_KEY=
SCENARIO_TEST_API_SECRET=
# Optional for API-key authentication. When set, selects the project for live-tool requests.
SCENARIO_TEST_PROJECT_ID=
# Optional REST base URL for tools/audit_payloads.py only:
# SCENARIO_API_BASE=
# Optional local MCP session token for the repository Claude Code and Codex entries,
# never a Scenario key.
# It changes when Blender restarts; copy it from the panel's Codex setup:
# SCENARIO_BLENDER_TOKEN=
# Paid smokes require separate authorization and command-line SCENARIO_SMOKE=1.
# Never store the spending opt-in in this file or .env.local.
