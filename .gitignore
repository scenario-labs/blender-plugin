# Local secrets (copy .env.example to .env.local)
.env*.local
!.env.example

# Python
__pycache__/
*.pyc
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.ruff_cache/
.venv/
venv/

# Build output
dist/
*.zip

# Interrupted fixture recordings are private staging, never published fixtures
/tests/fixtures/.recording-*/

# Per-machine files
.DS_Store
scenario_output/
# vercel link records the team and project IDs
.vercel/

# Working .blend files stay local; tools/blank.blend is the test scene
tools/*.blend
!tools/blank.blend
tools/*.blend?
*.blend1
*.blend2

# Node tooling installs with pnpm from pnpm-lock.yaml; npm's lockfile is not used
node_modules/
package-lock.json

# Private agent state and isolated Blender development profiles
CLAUDE.local.md
.claude/CLAUDE.local.md
.claude/settings.local.json
.claude/worktrees/
.blender-profile/

# Local execution plans and working files
/workdir/

# Downloaded Blender builds for native verification
.blender/

# Generated documentation
/site/
/docs/user-guide.html
