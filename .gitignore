# Local secrets (copy .env.example to .env.local)
.env*.local
!.env.example

# Python
__pycache__/
*.pyc
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.ruff_cache/
.venv/
venv/

# Build output
dist/
*.zip

# Per-machine files
.DS_Store
scenario_output/

# Working .blend files stay local; tools/blank.blend is the test scene
tools/*.blend
!tools/blank.blend
tools/*.blend?
*.blend1
*.blend2

# Commitlint run locally with the same npm command as CI
node_modules/
package-lock.json

# Private agent state and isolated Blender development profiles
CLAUDE.local.md
.claude/CLAUDE.local.md
.claude/settings.local.json
.blender-profile/

# Local execution plans and working files
/workdir/

# Downloaded Blender builds for native verification
.blender/

# Generated documentation
/site/
/docs/user-guide.html
