# The web app rejects automated clients; REST endpoints require credentials.
^https://app\.scenario\.com/
^https://api\.cloud\.scenario\.com/
# The attribution destination requires a browser challenge for automated GETs.
^https://projects\.blender\.org/
# Reserved placeholder hosts used in examples (RFC 2606).
^https?://[^/]*\.example(/|$)
(?i)^https?://(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)*example\.(?:com|org|net)\.?(?::[0-9]+)?(?:[/?#]|$)
# These exact repository forms redirect to GitHub login when unauthenticated.
^https://github\.com/scenario-labs/blender-plugin/(issues/new/choose|security/advisories/new)$
# Issue references in these internal repositories require organization access.
^https://github\.com/scenario-labs/(roadmap|scenario-sdk-python)/issues/[0-9]+(#.*)?$
# This exact organization project is private and returns 404 without access.
^https://github\.com/orgs/scenario-labs/projects/31$
# The internal roadmap repository root also requires organization access.
^https://github\.com/scenario-labs/roadmap$
