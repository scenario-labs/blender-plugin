{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [{ "source": "/repo", "destination": "/repo/", "permanent": true }],
  "rewrites": [
    { "source": "/handbook/page.js", "destination": "https://blender.scenario.com/_vercel/insights/script.js" },
    { "source": "/(.*)", "destination": "https://scenario-labs.github.io/blender-plugin/$1" }
  ]
}
